{
  "name": "homecare",
  "private": true,
  "version": "0.1.0",
  "description": "HomeCare — אפליקציית משימות הבית המשותפת (PWA, עברית, RTL)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-homecare \"vitest run --project rules\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-homecare \"vitest run --project integration\"",
    "test:e2e": "playwright test --project=demo",
    "test:e2e:emu": "firebase emulators:exec --only auth,firestore --project demo-homecare \"playwright test --project=emulator\"",
    "notify:test": "firebase emulators:exec --only firestore --project demo-homecare \"vitest run --project notifier\"",
    "notify:dry": "tsx scripts/notify/index.ts --dry"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "~1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.32.1",
    "jsdom": "^29.1.1",
    "playwright-core": "~1.56.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
