rules_version = '2';

// HomeCare: Firestore Security Rules (Blueprint §4, owner step 2.3).
//
// Threat model: the repository and the Firebase web config are public. An attacker can sign in with
// any Google account. Nothing may be read or written unless the caller is a member of the household
// (a households/{hid}/members/{uid} doc exists). Households and invites can never be listed.
//
// Stored document shapes, batching requirements and the exact writes the adapter must perform are
// specified in docs/firestore-schema.md. Conventions enforced everywhere below:
//   - Identity fields are NOT stored: task/event/photo/treat `id`, member `uid`, invite `code` and
//     device `deviceId` are the document ids. Client-only `pending` can never be stored.
//   - Every document has an exact key set (all keys present, no extra keys).
//   - "Now" timestamps must be serverTimestamp() (== request.time). Clients can never write an
//     arbitrary time; on update a timestamp is either unchanged, null (if nullable) or request.time.
//   - Attribution fields (createdBy, updatedBy, actorId, completedBy, requestedBy) can only name the
//     caller.
//
// Dependent-read budget (10 per document, 20 per batch). Calls on the same document are cached.
// Cheap, read-free checks always come first so short-circuiting skips reads.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────── Global helpers ─────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function hhPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // The caller is a member of household `hid` (state before this write). 1 read.
    function isMember(hid) {
      return signedIn() && exists(memberPath(hid, me()));
    }

    // The caller is a member once this write/batch commits (covers a joiner's own batch). 1 read.
    function isMemberAfter(hid) {
      return signedIn() && existsAfter(memberPath(hid, me()));
    }

    // The caller holds the owner role in `hid` (the founder; joiners are always 'member'). 1 read.
    function isOwner(hid) {
      return get(memberPath(hid, me())).data.role == 'owner';
    }

    // Household data before / after this write. 1 read each.
    function hh(hid) {
      return get(hhPath(hid)).data;
    }

    function hhAfter(hid) {
      return getAfter(hhPath(hid)).data;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Top-level keys changed by an update.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The map has exactly these keys: every one present, nothing else.
    function hasExactly(m, ks) {
      return m.keys().hasAll(ks) && m.keys().hasOnly(ks);
    }

    // ───────────────────────────── Value helpers ─────────────────────────────

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isInt(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    // Document id safe to interpolate into a path (Firestore auto ids are 20 base62 chars).
    function isSafeId(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    // Invite code: exactly 24 base62 chars (crypto.getRandomValues, ~143 bits).
    function isInviteCode(v) {
      return v is string && v.matches('^[0-9A-Za-z]{24}$');
    }

    // ISO calendar date 'YYYY-MM-DD' (month 01-12, day 01-31).
    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isNullOrIsoDate(v) {
      return v == null || isIsoDate(v);
    }

    // 'HH:mm', 00:00-23:59.
    function isNullOrTime(v) {
      return v == null || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    // A nullable "now" timestamp on create: null or serverTimestamp().
    function isNullOrNow(v) {
      return v == null || v == request.time;
    }

    // A nullable "now" timestamp on update: null, unchanged, or serverTimestamp().
    function stampOk(newV, oldV) {
      return newV == null || newV == oldV || newV == request.time;
    }

    // A nullable attribution field on update: null, unchanged, or the caller.
    function attributionOk(newV, oldV) {
      return newV == null || newV == oldV || newV == me();
    }

    // A future expiry, at most 7 days ahead.
    function isExpiry(v) {
      return v is timestamp && v > request.time && v <= request.time + duration.value(7, 'd');
    }

    // ───────────────────────────── Domain shapes ─────────────────────────────

    function isNotifyPrefs(n) {
      return n is map
        && hasExactly(n, ['requests', 'reminders', 'partnerDone', 'weekly'])
        && n.requests is bool && n.reminders is bool && n.partnerDone is bool && n.weekly is bool;
    }

    // Google account photo (lh3.googleusercontent.com etc.) or null. Restricting the host stops a
    // member from planting a tracking pixel that leaks the other members' IP addresses.
    function isPhotoURL(v) {
      return v == null
        || (v is string && v.size() <= 2048
            && v.matches('^https://[a-z0-9.-]+[.]googleusercontent[.]com/[^ ]*$'));
    }

    // Editable member profile fields (create and self-update).
    function isMemberProfile(d) {
      return isStr(d.displayName, 1, 40)
        && isPhotoURL(d.photoURL)
        && d.color in ['terracotta', 'sage', 'slate', 'plum', 'ochre', 'teal']
        && d.addressAs in ['f', 'm', 'n']
        && isNotifyPrefs(d.notify);
    }

    function isJar(j) {
      return j is map
        && hasExactly(j, ['treat', 'target', 'count', 'round', 'startedAt'])
        && isStr(j.treat, 1, 60)
        && isInt(j.target, 3, 50)
        && j.count is int && j.count >= 0
        && j.round is int && j.round >= 1
        && j.startedAt is timestamp;
    }

    // A brand-new jar (household create, or first setup from null).
    function isFreshJar(j) {
      return isJar(j) && j.count == 0 && j.round == 1 && j.startedAt == request.time;
    }

    // household.invite: the household's single active invite, or null.
    function isInviteRef(v) {
      return v == null
        || (v is map && hasExactly(v, ['code', 'expiresAt']) && isInviteCode(v.code) && isExpiry(v.expiresAt));
    }

    // Jar transitions allowed in one write (strictness decision, see docs/firestore-schema.md):
    //   unchanged | first setup | edit treat/target | count +1 (complete) | count -1 (reopen, never < 0)
    //   | redeem (only when full; surplus carries over; round +1; restart clock; treat recorded).
    // The jar can never be removed once set (a re-created round 1 would collide with treats/1).
    function jarTransitionOk(hid, o, n) {
      return n == o
        || (o == null && isFreshJar(n))
        || (o != null && isJar(n) && (
              // edit treat and/or target; progress untouched
              (n.count == o.count && n.round == o.round && n.startedAt == o.startedAt)
              // completion +1 / reopen -1 (isJar already guarantees count >= 0)
              || (n.treat == o.treat && n.target == o.target && n.round == o.round
                  && n.startedAt == o.startedAt
                  && (n.count == o.count + 1 || n.count == o.count - 1))
              // redeem: requires treats/{round} to be created in the same batch
              || (n.treat == o.treat && n.target == o.target
                  && o.count >= o.target
                  && n.count == o.count - o.target
                  && n.round == o.round + 1
                  && n.startedAt == request.time
                  && existsAfter(/databases/$(database)/documents/households/$(hid)/treats/$(string(o.round))))
           ));
    }

    function isRecurrence(r) {
      return r == null
        || (r is map
            && r.keys().hasAll(['freq'])
            && r.keys().hasOnly(['freq', 'anchor'])
            && r.freq in ['weekly', 'monthly', 'yearly']
            && (!('anchor' in r) || isIsoDate(r.anchor)));
    }

    function isPhotoId(v) {
      return isStr(v, 1, 128);
    }

    function isCompletion(c) {
      return c is map
        && hasExactly(c, ['note', 'cost', 'place', 'contact', 'photoIds'])
        && isStr(c.note, 0, 2000)
        && (c.cost == null || (c.cost is number && c.cost >= 0 && c.cost <= 10000000))
        && isStr(c.place, 0, 120)
        && isStr(c.contact, 0, 120)
        && c.photoIds is list
        && c.photoIds.size() <= 3
        && (c.photoIds.size() < 1 || isPhotoId(c.photoIds[0]))
        && (c.photoIds.size() < 2 || isPhotoId(c.photoIds[1]))
        && (c.photoIds.size() < 3 || isPhotoId(c.photoIds[2]));
    }

    // Shape of a stored Task (Task minus `id` and `pending`), shared by create and update.
    function isTaskShape(d) {
      return hasExactly(d, [
          'title', 'notes', 'categoryId', 'priority', 'ownerId', 'requestedBy', 'requestedAt',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'scheduledFor', 'weekPlan', 'dueDate',
          'dueTime', 'hardDeadline', 'recurrence', 'seriesId', 'status', 'snoozeCount', 'lastSnoozedAt',
          'completedAt', 'completedBy', 'completion'])
        && isStr(d.title, 1, 200)
        && isStr(d.notes, 0, 4000)
        && (d.categoryId == null
            || d.categoryId in ['car', 'shopping', 'home', 'health', 'finance', 'returns', 'family', 'other'])
        && d.priority in ['normal', 'high', 'urgent']
        && d.status in ['open', 'done']
        && (d.ownerId == null || isStr(d.ownerId, 1, 128))
        && (d.requestedBy == null || isStr(d.requestedBy, 1, 128))
        && (d.requestedAt == null || d.requestedAt is timestamp)
        && ((d.requestedBy == null) == (d.requestedAt == null))
        && d.createdAt is timestamp
        && d.updatedBy == me()
        && d.updatedAt == request.time
        && isNullOrIsoDate(d.scheduledFor)
        && d.weekPlan is bool
        // a week plan is stored as the Saturday ending the week, so it needs a date
        && (!d.weekPlan || d.scheduledFor != null)
        && isNullOrIsoDate(d.dueDate)
        && isNullOrTime(d.dueTime)
        && d.hardDeadline is bool
        && isRecurrence(d.recurrence)
        && (d.seriesId == null || isStr(d.seriesId, 1, 60))
        && d.snoozeCount is int && d.snoozeCount >= 0
        && (d.lastSnoozedAt == null || d.lastSnoozedAt is timestamp)
        && (d.completedAt == null || d.completedAt is timestamp)
        && (d.completedBy == null || isStr(d.completedBy, 1, 128))
        && (d.completion == null || isCompletion(d.completion))
        // status invariant: open ⇒ no completion data; done ⇒ who and when are recorded
        && ((d.status == 'open' && d.completedAt == null && d.completedBy == null && d.completion == null)
            || (d.status == 'done' && d.completedAt != null && d.completedBy != null));
    }

    // ───────────────────────────── households/{hid} ─────────────────────────────

    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false; // households are never listable

      // Founder batch: this doc + members/{uid} (role 'owner') in the same batch.
      allow create: if signedIn()
        && hasExactly(incoming(), ['name', 'memberIds', 'memberCount', 'maxMembers', 'createdBy',
                                   'createdAt', 'jar', 'invite'])
        && isStr(incoming().name, 1, 60)
        && incoming().memberIds == [me()]
        && incoming().memberCount == 1
        && incoming().maxMembers == 6
        && incoming().createdBy == me()
        && incoming().createdAt == request.time
        && (incoming().jar == null || isFreshJar(incoming().jar))
        && incoming().invite == null
        && existsAfter(memberPath(hid, me()));

      allow update: if signedIn() && (memberEdit() || joinSelf() || removeMember());

      allow delete: if false;

      // A member edits name / jar / invite. Nothing else is writable by members.
      function memberEdit() {
        return changed().hasOnly(['name', 'jar', 'invite'])
          && isMember(hid)
          && (!changed().hasAny(['name']) || isStr(incoming().name, 1, 60))
          && (!changed().hasAny(['invite']) || isInviteRef(incoming().invite))
          && (!changed().hasAny(['jar']) || jarTransitionOk(hid, existing().jar, incoming().jar));
      }

      // Join batch: the caller appends ONLY themself (arrayUnion + increment(1)) and creates their
      // members doc (validated against the invite) in the same batch.
      function joinSelf() {
        return changed().hasAll(['memberIds', 'memberCount'])
          && changed().hasOnly(['memberIds', 'memberCount'])
          && !(me() in existing().memberIds)
          && incoming().memberIds == existing().memberIds.concat([me()])
          && incoming().memberIds.size() == existing().memberIds.size() + 1
          && incoming().memberCount == incoming().memberIds.size()
          && incoming().memberCount <= existing().maxMembers
          && existsAfter(memberPath(hid, me()));
      }

      // Leave (remove self) or owner removal (remove someone else), mirror image of join: exactly
      // one uid leaves memberIds (arrayRemove + increment(-1)) and its members doc is deleted in the
      // same batch. The active invite may be cleared on the way out, and MUST be cleared when
      //   - an owner removes someone (the removed member knows the code and could just rejoin), or
      //   - the last member leaves (else the link would admit a stranger into an empty household).
      function removeMember() {
        let gone = existing().memberIds.removeAll(incoming().memberIds);
        return changed().hasAll(['memberIds', 'memberCount'])
          && changed().hasOnly(['memberIds', 'memberCount', 'invite'])
          && gone.size() == 1
          && incoming().memberIds == existing().memberIds.removeAll([gone[0]])
          && incoming().memberIds.size() == existing().memberIds.size() - 1
          && incoming().memberCount == incoming().memberIds.size()
          && (!changed().hasAny(['invite']) || incoming().invite == null)
          && (incoming().memberIds.size() > 0 || incoming().invite == null)
          && (gone[0] == me() || (incoming().invite == null && isOwner(hid)))
          && !existsAfter(memberPath(hid, gone[0]));
      }

      // ─────────────────────── households/{hid}/members/{uid} ───────────────────────

      match /members/{uid} {
        allow get, list: if isMember(hid);

        allow create: if signedIn()
          && me() == uid
          && hasExactly(incoming(), ['displayName', 'photoURL', 'color', 'addressAs', 'role',
                                     'joinedAt', 'notify', 'inviteCode'])
          && isMemberProfile(incoming())
          && incoming().joinedAt == request.time
          && (founderCreate() || joinerCreate());

        // Self only; role, joinedAt and inviteCode are immutable.
        allow update: if signedIn()
          && me() == uid
          && changed().hasOnly(['displayName', 'photoURL', 'color', 'addressAs', 'notify'])
          && isMemberProfile(incoming());

        // Leave (self) or owner removal; the household's memberIds must drop the uid in the same batch.
        // (resource != null: deleting a missing doc must not double as a household-existence probe.)
        allow delete: if signedIn()
          && resource != null
          && (me() == uid || isOwner(hid))
          && !(uid in hhAfter(hid).memberIds);

        // Founder: the household is being created by the caller in this same batch.
        function founderCreate() {
          return incoming().role == 'owner'
            && incoming().inviteCode == null
            && !exists(hhPath(hid))
            && hhAfter(hid).createdBy == me();
        }

        // Joiner: presents the household's current, unrevoked, unexpired invite; the household is
        // not full; and the caller is appended to memberIds in the same batch. Role forced 'member'.
        function joinerCreate() {
          let code = incoming().inviteCode;
          return incoming().role == 'member'
            && isInviteCode(code)
            && inviteAdmits(get(invitePath(code)).data, hh(hid), code)
            && me() in hhAfter(hid).memberIds;
        }

        function inviteAdmits(inv, h, code) {
          return inv.householdId == hid
            && inv.revoked == false
            && inv.expiresAt > request.time
            && h.invite != null
            && h.invite.code == code
            && h.memberCount < h.maxMembers;
        }
      }

      // ─────────────────────── households/{hid}/tasks/{taskId} ───────────────────────

      match /tasks/{taskId} {
        allow get, list: if isMember(hid);

        allow create: if isMember(hid)
          && isTaskShape(incoming())
          && incoming().createdBy == me()
          && incoming().createdAt == request.time
          && incoming().status == 'open'
          && (incoming().ownerId == null || incoming().ownerId in hh(hid).memberIds)
          && (incoming().requestedBy == null || incoming().requestedBy == me())
          && isNullOrNow(incoming().requestedAt)
          && incoming().lastSnoozedAt == null;

        allow update: if isMember(hid)
          && isTaskShape(incoming())
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && (incoming().ownerId == existing().ownerId
              || incoming().ownerId == null
              || incoming().ownerId in hh(hid).memberIds)
          && attributionOk(incoming().requestedBy, existing().requestedBy)
          && attributionOk(incoming().completedBy, existing().completedBy)
          && stampOk(incoming().requestedAt, existing().requestedAt)
          && stampOk(incoming().lastSnoozedAt, existing().lastSnoozedAt)
          && stampOk(incoming().completedAt, existing().completedAt);

        allow delete: if isMember(hid);
      }

      // ─────────────────────── households/{hid}/events/{eventId} ───────────────────────

      match /events/{eventId} {
        allow get, list: if isMember(hid);

        // isMemberAfter so a joiner's member_joined event can ride in the join batch.
        // push: 'pending' exactly for the notifiable types, else 'none'. 'sent'/'skipped' are
        // written by the notifier (Admin SDK) only.
        allow create: if isMemberAfter(hid)
          && hasExactly(incoming(), ['type', 'actorId', 'taskId', 'taskTitle', 'targetId',
                                     'createdAt', 'push'])
          && incoming().type in ['created', 'taken', 'requested', 'released', 'completed', 'reopened',
                                 'snoozed', 'edited', 'deleted', 'jar_filled', 'jar_redeemed',
                                 'member_joined']
          && incoming().actorId == me()
          && (incoming().taskId == null || isStr(incoming().taskId, 1, 128))
          && (incoming().taskTitle == null || isStr(incoming().taskTitle, 1, 200))
          && (incoming().targetId == null || isStr(incoming().targetId, 1, 128))
          && incoming().createdAt == request.time
          && incoming().push
               == (incoming().type in ['requested', 'completed', 'jar_filled'] ? 'pending' : 'none');

        allow update, delete: if false;
      }

      // ─────────────────────── households/{hid}/photos/{photoId} ───────────────────────

      match /photos/{photoId} {
        allow get, list: if isMember(hid);

        allow create: if isMember(hid)
          && hasExactly(incoming(), ['taskId', 'dataUrl', 'thumbDataUrl', 'width', 'height',
                                     'createdBy', 'createdAt'])
          && isStr(incoming().taskId, 1, 128)
          && isStr(incoming().dataUrl, 24, 300000)
          && incoming().dataUrl[0:23] == 'data:image/jpeg;base64,'
          && isStr(incoming().thumbDataUrl, 24, 20000)
          && incoming().thumbDataUrl[0:23] == 'data:image/jpeg;base64,'
          && isInt(incoming().width, 1, 4096)
          && isInt(incoming().height, 1, 4096)
          && incoming().createdBy == me()
          && incoming().createdAt == request.time;

        allow delete: if isMember(hid);
        allow update: if false;
      }

      // ─────────────────────── households/{hid}/treats/{round} ───────────────────────

      match /treats/{round} {
        allow get, list: if isMember(hid);

        // Redeem batch: created for the CURRENT round of a FULL jar, copying its treat/target, while
        // the same batch advances the jar to round + 1.
        allow create: if isMember(hid)
          && hasExactly(incoming(), ['treat', 'target', 'filledAt', 'redeemedAt'])
          && round.matches('^[1-9][0-9]{0,5}$')
          && treatMatchesJar(hh(hid).jar, hhAfter(hid).jar);

        // Only redeemedAt may be set, once, to now.
        allow update: if isMember(hid)
          && changed().hasOnly(['redeemedAt'])
          && existing().redeemedAt == null
          && incoming().redeemedAt == request.time;

        allow delete: if false;

        function treatMatchesJar(jar, after) {
          return jar != null
            && round == string(jar.round)
            && jar.count >= jar.target
            && incoming().treat == jar.treat
            && incoming().target == jar.target
            && incoming().filledAt is timestamp
            && incoming().filledAt >= jar.startedAt
            && incoming().filledAt <= request.time
            && isNullOrNow(incoming().redeemedAt)
            && after != null
            && after.round == jar.round + 1;
        }
      }

      // ─────────────────────── households/{hid}/sent/{key} ───────────────────────
      // Notifier dedupe log. Admin SDK only (bypasses rules); no client access at all.
      match /sent/{key} {
        allow read, write: if false;
      }
    }

    // ───────────────────────────── invites/{code} ─────────────────────────────
    // A bearer secret: anyone signed in who knows the 24-char code may read it (invite preview).

    match /invites/{code} {
      allow get: if signedIn() && code.size() == 24;
      allow list: if false;

      allow create: if signedIn()
        && isInviteCode(code)
        && hasExactly(incoming(), ['householdId', 'householdName', 'inviterName', 'memberCount',
                                   'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && isSafeId(incoming().householdId)
        && isStr(incoming().householdName, 1, 60)
        && isStr(incoming().inviterName, 1, 40)
        && isInt(incoming().memberCount, 1, 6)
        && incoming().createdBy == me()
        && incoming().createdAt == request.time
        && isExpiry(incoming().expiresAt)
        && incoming().revoked == false
        && isMember(incoming().householdId);

      // Revoke only (one-way).
      allow update: if signedIn()
        && changed().hasOnly(['revoked'])
        && incoming().revoked == true
        && isMember(existing().householdId);

      allow delete: if false;
    }

    // ───────────────────────────── users/{uid} ─────────────────────────────

    match /users/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list: if false;

      allow create: if signedIn() && me() == uid
        && isUserDoc(incoming())
        && incoming().createdAt == request.time;

      allow update: if signedIn() && me() == uid
        && isUserDoc(incoming())
        && stampOk(incoming().createdAt, existing().createdAt) && incoming().createdAt != null;

      allow delete: if signedIn() && me() == uid;

      // householdId may only point at a household the caller is (or becomes, in this batch) a member of.
      function isUserDoc(d) {
        return hasExactly(d, ['householdId', 'createdAt'])
          && (d.householdId == null
              || (isSafeId(d.householdId) && existsAfter(memberPath(d.householdId, me()))));
      }

      match /devices/{deviceId} {
        allow get, list: if signedIn() && me() == uid;

        allow create: if signedIn() && me() == uid
          && isDeviceDoc(incoming())
          && incoming().createdAt == request.time;

        allow update: if signedIn() && me() == uid
          && isDeviceDoc(incoming())
          && stampOk(incoming().createdAt, existing().createdAt) && incoming().createdAt != null;

        allow delete: if signedIn() && me() == uid;

        // A push target only for a household the caller belongs to (the notifier must still
        // re-check current membership before sending).
        function isDeviceDoc(d) {
          return isStr(deviceId, 1, 64)
            && hasExactly(d, ['householdId', 'token', 'userAgent', 'createdAt', 'updatedAt'])
            && isStr(d.token, 1, 4096)
            && isStr(d.userAgent, 0, 512)
            && d.updatedAt == request.time
            && isSafeId(d.householdId)
            && existsAfter(memberPath(d.householdId, me()));
        }
      }
    }
  }
}
