{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM is included because Playwright callbacks (page.evaluate) run in the browser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "svelte.config.js",
    "pwa-assets.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs"
  ],
  // scripts/notify has its own package.json (firebase-admin) and its own tsconfig (step 5.2).
  "exclude": ["scripts/notify/**", "node_modules"]
}
